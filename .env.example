# ─────────────────────────────────────────────────────────────────────────────
# Ranvier by Noos — variáveis de ambiente (modelo)
# Copie para .env e ajuste:  cp .env.example .env
# Documentação completa: docs/DEPLOY.md (§1 dev local, §3 Neon, §4 Vercel, §8 ads)
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ──────────────────────────────────────────────────────────
# Dev/sandbox (SQLite) — caminho relativo ao prisma/schema.prisma:
DATABASE_URL="file:../db/custom.db"

# Produção (Neon Postgres — use a string POOLED, com sslmode=require; ver DEPLOY.md §3):
# DATABASE_URL="postgresql://<user>:<password>@<ep-xxx-pooler>.<region>.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# ── Segredo de sessão (OBRIGATÓRIO em produção) ────────────────────────────
# Assina (HMAC) os cookies ct_anon / ct_session.
# Gere um valor único com:  openssl rand -hex 32
# NUNCA reutilize o valor do sandbox em produção.
SESSION_SECRET=""

# ── Hub do ecossistema Noos ─────────────────────────────────────────────────
# Base dos deep-links "Comunidade" ({base}/{lang}/q/{id}) e do badge do rodapé.
# Trocar para https://noos.study quando o domínio existir (DEPLOY.md §9).
NEXT_PUBLIC_NOOS_HUB_URL="https://noos-hub.vercel.app"

# ── Google AdSense (OPCIONAL — desligado por padrão) ───────────────────────
# Enquanto NEXT_PUBLIC_ADSENSE_CLIENT estiver vazio, nenhum código do Google
# é carregado. Variáveis NEXT_PUBLIC_* são embutidas no build: mudar exige
# redeploy. Política de colocação: DEPLOY.md §8.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=""
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=""
